{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mathematics-atlas/graph-input-v1.schema.json",
  "title": "Laplacian bridge atlas graph input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["n", "edges", "source", "target"],
  "properties": {
    "n": {"type": "integer", "minimum": 2, "maximum": 6},
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [{"type": "integer"}, {"type": "integer"}],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "source": {"type": "integer", "minimum": 0},
    "target": {"type": "integer", "minimum": 0}
  }
}

