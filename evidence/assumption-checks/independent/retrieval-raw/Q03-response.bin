{"theorems":[{"slogan_id":2104428,"theorem_id":18134454,"name":"Theorem 2.2 (Kirchhoff’s formula {\\cite[Section 4.2]{LP16}})","body":"Given a weighted graph $(G, \\textup{\\textrm{w}})$, the probability that an edge $(u,v)$ is in the (weighted) uniform spanning tree is\\begin{equation}   \\boldsymbol {\\mathrm{P}}\\big( (u,v) \\in \\mathcal{T} \\big) = \\textup{\\textrm{w}}(u,v) {\\rm R}_{\\rm eff}^{}(u \\leftrightarrow v). \\end{equation}","slogan":"The probability an edge is in the weighted uniform spanning tree equals the product of its weight and the effective resistance between its endpoints.","theorem_type":"theorem","label":null,"link":null,"paper":{"paper_id":"2410.16836v3","source":"arXiv","title":"Local limits of random spanning trees in random environment","authors":["Luca Makowiec"],"link":"http://arxiv.org/abs/2410.16836v3","summary":null,"journal_ref":null,"primary_category":"math.PR","categories":["math.PR","math.CO"],"citations":0,"year":2024,"journal_published":false},"similarity":0.8405209658977506,"score":0.8405209658977506,"has_metadata":true},{"slogan_id":2134827,"theorem_id":18165234,"name":"Theorem 2.1 (Kirchhoff’s Formula)","body":"Given any finite electrical network $(G, \\textup{\\textrm{w}})$ and corresponding weighted UST measure $\\boldsymbol {\\mathrm{P}}^\\textup{\\textrm{w}}_G$, we have\\begin{equation}   \\boldsymbol {\\mathrm{P}}^\\textup{\\textrm{w}}_G \\big( (u,v) \\in {\\mathcal T} \\big) = \\textup{\\textrm{w}}(u,v) {\\rm R}_{\\rm eff}^{\\textup{\\textrm{w}}}(u \\leftrightarrow v)\\, . \\end{equation}","slogan":"The probability that an edge is in a uniformly random spanning tree equals the product of its weight and the effective resistance between its endpoints. This holds for any finite electrical network with given edge weights. The result connects graph theory and electrical network concepts. It is known as Kirchhoff's effective resistance formula.","theorem_type":"theorem","label":null,"link":null,"paper":{"paper_id":"2410.16830v3","source":"arXiv","title":"Random spanning trees in random environment","authors":["Luca Makowiec","Michele Salvi","Rongfeng Sun"],"link":"http://arxiv.org/abs/2410.16830v3","summary":null,"journal_ref":null,"primary_category":"math.PR","categories":["math.PR","math.CO"],"citations":0,"year":2024,"journal_published":false},"similarity":0.7936569471189552,"score":0.7936569471189552,"has_metadata":true}]}