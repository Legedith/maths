{"theorems":[{"slogan_id":9527643,"theorem_id":24585048,"name":"Lemma 2.1","body":" For any edge $e^* \\in E(G)$ between two vertices $a, b \\in V(G)$, the effective resistance $R_{ab}$ is equal to the probability that $e^*$ is in a uniformly chosen spanning tree of $G$.","slogan":"The effective resistance between two vertices connected by an edge equals the probability that the edge is included in a uniformly random spanning tree.","theorem_type":"lemma","label":null,"link":null,"paper":{"paper_id":"2109.13394v2","source":"arXiv","title":"Compact Redistricting Plans Have Many Spanning Trees","authors":["Ariel D. Procaccia","Jamie Tucker-Foltz"],"link":"http://arxiv.org/abs/2109.13394v2","summary":null,"journal_ref":null,"primary_category":"cs.DM","categories":["cs.DM","cs.CY","math.CO"],"citations":0,"year":2021,"journal_published":false},"similarity":0.8368878364562988,"score":0.8368878364562988,"has_metadata":true},{"slogan_id":7383631,"theorem_id":22467127,"name":"Lemma 6","body":"Let $G$ be a graph and ${\\mathcal{T}}$ a draw from $UST(G)$.\\[  \\mathbb {P}\\{  e \\in {\\mathcal{T}}\\}  = r_e  \\]","slogan":"The probability that a given edge is in a uniformly random spanning tree of a graph equals the effective resistance of that edge.","theorem_type":"lemma","label":null,"link":null,"paper":{"paper_id":"1206.0937v3","source":"arXiv","title":"Detecting Activations over Graphs using Spanning Tree Wavelet Bases","authors":["James Sharpnack","Akshay Krishnamurthy","Aarti Singh"],"link":"http://arxiv.org/abs/1206.0937v3","summary":null,"journal_ref":null,"primary_category":"stat.ML","categories":["stat.ML","cs.IT","math.ST"],"citations":0,"year":2012,"journal_published":false},"similarity":0.8140686528764607,"score":0.8140686528764607,"has_metadata":true}]}