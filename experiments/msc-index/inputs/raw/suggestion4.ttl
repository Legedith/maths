                                         rdfs:comment """ Construct direct link between skos:Concepts and targets of conditional reference:

PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix skos: <http://www.w3.org/2004/02/skos/core#>
prefix mscvocab: <http://msc2020.org/resources/MSC/msc2020/mscvocab#>

#select ?s 
construct {?s mscvocab:seeConditionally ?ob . }
where 
{?s a skos:Concept . 
?s mscvocab:seeFor ?x .
?x rdf:object ?ob .}
 """ ,
                                                      """Construction of Top Concepts:
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix skos: <http://www.w3.org/2004/02/skos/core#>
prefix msc: <http://msc2020.org/resources/MSC/msc2020/>

#select *
construct {msc: skos:hasTopConcept ?s}
where
{
?s a skos:Concept ; skos:notation ?notation
filter regex (?notation,  \"\\d\\d-XX\")
}

order by ?notation""" ,
                                                      """Construction of skos:broader


PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix skos: <http://www.w3.org/2004/02/skos/core#>
prefix msc: <http://msc2020.org/resources/MSC/msc2020/>

#level 1 zu level 2 - variante a
construct {?s skos:broader msc:00-XX . }
where
{
?s a skos:Concept ; skos:notation ?notation.
filter regex (?notation, \"00-\\d\\d\")
}

#level 1 zu level 2 - variante b
construct {?s skos:broader msc:00Axx . }
where
{
?s a skos:Concept ; skos:notation ?notation.
#filter regex (?notation,  \"00-\\d\\d\")
filter regex (?notation, \"00A\\d\\d\")
}

#level 2 zu level 3
#select *
construct {?s skos:broader msc:97Uxx . }
where
{
?s a skos:Concept ; skos:notation ?notation.
#filter regex (?notation,  \"00-\\d\\d\")
filter regex (?notation, \"97U\\d\\d\")
}""" ,
                                                      """Get members of a collection based on notation
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix skos: <http://www.w3.org/2004/02/skos/core#>
select ?s
where
{
?s a skos:Concept; skos:notation ?notation .
filter (strends (?notation ,\"-00\"))
}""" ;
                                         rdfs:label "Mathematics Subject Classification 2020"@en ;
                                         rdfs:comment: """
 The MSC 2010 is the subject scheme for mathematics prepared jointly by Mathematical Reviews (of the AMS) and ZBMath (of FIZ Karlsruhe).  It is widely recognized as the mathematical community's classification scheme.
        """@en ,
                                                       " [add some explanaroty text about the SKOS conversion 2020, maybe changed design decisions, reference to the paper]" .

